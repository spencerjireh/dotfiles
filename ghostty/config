# Ghostty Terminal Configuration - Vesper Theme
# Peppermint & orange flavored dark theme with hidden tabs

# Font Configuration
font-family = "GohuFont 14 Nerd Font Mono"
font-size = 16
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = calt

# Background transparency (80% opacity = 0.8)
background-opacity = 0.8

# Vesper Theme Colors (Official Palette)
background = 101010
foreground = ffffff

# Black
palette = 0=#101010
palette = 8=#505050

# Red
palette = 1=#ff8080
palette = 9=#ff8080

# Green
palette = 2=#80d9c7
palette = 10=#80d9c7

# Yellow
palette = 3=#ffc799
palette = 11=#ffc799

# Blue
palette = 4=#65737e
palette = 12=#8b8b8b

# Magenta
palette = 5=#ffcfa8
palette = 13=#ffcfa8

# Cyan
palette = 6=#99ffe4
palette = 14=#99ffe4

# White
palette = 7=#a0a0a0
palette = 15=#ffffff

# Cursor
cursor-color = ffc799
cursor-style = block
cursor-style-blink = true

# Selection
selection-background = 2a2a2a
selection-foreground = ffffff

# Window settings
window-padding-x = 4
window-padding-y = 4
window-theme = dark

# Hide titlebar (tmux handles window management)
gtk-tabs-location = hidden
macos-titlebar-style = hidden
	
# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Clipboard
clipboard-read = allow
clipboard-write = allow

# Mouse
mouse-hide-while-typing = true

# Performance
resize-overlay = never
window-vsync = true

# Advanced Visual Effects
background-blur = true
window-step-resize = true
window-save-state = always
window-inherit-working-directory = true
window-inherit-font-size = true
unfocused-split-opacity = 0.7

# Scrollback & History (tmux owns scrollback; Ghostty keeps its default)
link-url = true
mouse-scroll-multiplier = 3

# Terminal Behavior (TERM stays xterm-ghostty; tmux sets tmux-256color inside)
bold-is-bright = true
focus-follows-mouse = true

# Image Support
image-storage-limit = 1000000000

# Font Rendering
freetype-load-flags = no-hinting

# Open maximized (replaces the old window-height/width = 9999 hack)
maximize = true

# Option sends Alt sequences (fzf Alt+C, readline Alt-b/f); accented input via
# Option stops working. Cmd+N below still sends \x1bN by text, independent of this.
macos-option-as-alt = true

# Window management handled by tmux
# See ~/.dotfiles/tmux/tmux.conf

# Translate cmd+shift+space to ctrl+space for tmux prefix
keybind = cmd+shift+space=text:\x00

# Cmd+Shift+A/D to navigate tmux windows (sends prefix+h / prefix+l)
keybind = cmd+shift+a=text:\x00h
keybind = cmd+shift+d=text:\x00l

# Cmd+number to switch tmux windows (sends Alt+N; a later bind replaces the
# default goto_tab, so no explicit unbind is needed)
keybind = cmd+one=text:\x1b1
keybind = cmd+two=text:\x1b2
keybind = cmd+three=text:\x1b3
keybind = cmd+four=text:\x1b4
keybind = cmd+five=text:\x1b5
keybind = cmd+six=text:\x1b6
keybind = cmd+seven=text:\x1b7
keybind = cmd+eight=text:\x1b8
keybind = cmd+nine=text:\x1b9
