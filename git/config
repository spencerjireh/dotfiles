# Tracked git config, included from ~/.gitconfig via include.path.
# user.name / user.email stay in ~/.gitconfig (set by install.sh).

[core]
    editor = nvim
    pager = delta

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[rebase]
    autoStash = true

[fetch]
    prune = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true

[alias]
    nuke = "!sh -c 'printf \"Nuke working tree? This will reset --hard and remove untracked files. [y/N] \" && read ans && [ \"$ans\" = y ] && git reset --hard HEAD && git clean -fd && echo \"Nuked.\" || echo \"Aborted.\"'"
    wowow = log --oneline --graph --decorate --all
    undo = reset --soft HEAD~1
    branches = branch --sort=-committerdate --format='%(refname:short) (%(committerdate:relative))'
